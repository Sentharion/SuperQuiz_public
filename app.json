{
  "expo": {
    "name": "SuperQuiz",
    "slug": "SuperQuiz",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "superquiz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002050"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sentharion.SuperQuiz"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03071b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}